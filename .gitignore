# Large Datasets (Cached Parquet Files - auto-fetched via KaggleHub / local caching)
# The 2023-2026 price archive in data/historical_parquet/parquet/ is committed so the
# deployed app can forecast; anything else extracted there stays local.
data/historical_parquet/*
!data/historical_parquet/parquet/
data/historical_parquet/parquet/*
!data/historical_parquet/parquet/202[3-6].parquet

# Local user database: each deployment starts fresh and seeds the demo accounts
data/krishi_ai.db
data/*.db-journal

